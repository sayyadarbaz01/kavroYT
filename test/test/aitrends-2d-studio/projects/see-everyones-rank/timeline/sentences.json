[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.76,
  "text": "The guy next to you in economics is number 412."
 },
 {
  "i": 1,
  "start": 3.8,
  "end": 9.58,
  "text": "Not 412 in the class, 412 on earth, out of 8 billion people."
 },
 {
  "i": 2,
  "start": 9.98,
  "end": 10.32,
  "text": "And you?"
 },
 {
  "i": 3,
  "start": 10.88,
  "end": 13.3,
  "text": "You're number 6914 million."
 },
 {
  "i": 4,
  "start": 13.8,
  "end": 15.02,
  "text": "He's drooling on his notes."
 },
 {
  "i": 5,
  "start": 15.46,
  "end": 17.12,
  "text": "You've done every reading this semester."
 },
 {
  "i": 6,
  "start": 17.68,
  "end": 19.52,
  "text": "Something is seriously wrong here."
 },
 {
  "i": 7,
  "start": 19.84,
  "end": 29.56,
  "text": "By the end of this video, you'll find out what the number really measures, who is ranked number 3 on the entire planet, and how one sentence moved you billions of places in 5 seconds."
 },
 {
  "i": 8,
  "start": 29.96,
  "end": 32.32,
  "text": "But first, this morning, when it started."
 },
 {
  "i": 9,
  "start": 32.86,
  "end": 38.32,
  "text": "You wake up, you brush your teeth, and the first thing you notice is a number floating above your own head in the mirror."
 },
 {
  "i": 10,
  "start": 38.72,
  "end": 39.68,
  "text": "You try to wave it away."
 },
 {
  "i": 11,
  "start": 40.06,
  "end": 42.32,
  "text": "It follows your hand like a balloon on a string."
 },
 {
  "i": 12,
  "start": 42.78,
  "end": 45.7,
  "text": "Your roommate Dev walks in, eating cereal straight from the box."
 },
 {
  "i": 13,
  "start": 46.22,
  "end": 47.58,
  "text": "2 billion, 200 million."
 },
 {
  "i": 14,
  "start": 48.14,
  "end": 49.46,
  "text": "Why are you staring at my forehead?"
 },
 {
  "i": 15,
  "start": 49.9,
  "end": 50.22,
  "text": "No reason."
 },
 {
  "i": 16,
  "start": 50.8,
  "end": 52.64,
  "text": "Out in the hallway, everyone has one."
 },
 {
  "i": 17,
  "start": 52.98,
  "end": 55.22,
  "text": "The RA, 788 million."
 },
 {
  "i": 18,
  "start": 55.64,
  "end": 57.38,
  "text": "The girl who plays guitar at 2 in the morning?"
 },
 {
  "i": 19,
  "start": 57.38,
  "end": 58.92,
  "text": "3 .3 billion."
 },
 {
  "i": 20,
  "start": 59.48,
  "end": 61.5,
  "text": "The campus dog has no number at all."
 },
 {
  "i": 21,
  "start": 61.94,
  "end": 62.32,
  "text": "Lucky dog."
 },
 {
  "i": 22,
  "start": 62.86,
  "end": 64.6,
  "text": "The vending machine that ate your dollar on Monday?"
 },
 {
  "i": 23,
  "start": 65.02,
  "end": 65.9,
  "text": "8 billion in one."
 },
 {
  "i": 24,
  "start": 66.28,
  "end": 67.0,
  "text": "That one makes sense."
 },
 {
  "i": 25,
  "start": 67.42,
  "end": 68.82,
  "text": "By lunch, you've worked out the rule."
 },
 {
  "i": 26,
  "start": 69.3,
  "end": 70.88,
  "text": "One is the best human alive."
 },
 {
  "i": 27,
  "start": 71.26,
  "end": 72.52,
  "text": "8 billion is the worst."
 },
 {
  "i": 28,
  "start": 72.98,
  "end": 73.9,
  "text": "Everyone gets ranked."
 },
 {
  "i": 29,
  "start": 74.28,
  "end": 75.36,
  "text": "Nobody else can see it."
 },
 {
  "i": 30,
  "start": 75.6,
  "end": 76.62,
  "text": "And nobody explains."
 },
 {
  "i": 31,
  "start": 78.64,
  "end": 79.92,
  "text": "Your first guess is money."
 },
 {
  "i": 32,
  "start": 80.26,
  "end": 81.16,
  "text": "So, you test it."
 },
 {
  "i": 33,
  "start": 81.4,
  "end": 86.44,
  "text": "The richest kid on campus, the one who parks his car across two spaces, is number 1 .9 billion."
 },
 {
  "i": 34,
  "start": 86.92,
  "end": 87.36,
  "text": "Not great."
 },
 {
  "i": 35,
  "start": 87.36,
  "end": 91.46,
  "text": "The woman mopping the dining hall floor is 9 ,844."
 },
 {
  "i": 36,
  "start": 92.04,
  "end": 94.5,
  "text": "She is ranked higher than every student in this building."
 },
 {
  "i": 37,
  "start": 94.9,
  "end": 95.96,
  "text": "So, it's not money."
 },
 {
  "i": 38,
  "start": 96.4,
  "end": 97.64,
  "text": "You try celebrities on your phone."
 },
 {
  "i": 39,
  "start": 98.14,
  "end": 98.36,
  "text": "Nothing."
 },
 {
  "i": 40,
  "start": 99.1,
  "end": 100.32,
  "text": "Numbers only show up in person."
 },
 {
  "i": 41,
  "start": 100.9,
  "end": 101.5,
  "text": "Dev sits down."
 },
 {
  "i": 42,
  "start": 101.84,
  "end": 102.88,
  "text": "You tell him everything."
 },
 {
  "i": 43,
  "start": 103.42,
  "end": 106.68,
  "text": "So, you're saying you can see a number over my head and it's 2 billion."
 },
 {
  "i": 44,
  "start": 107.2,
  "end": 107.86,
  "text": "2 .2."
 },
 {
  "i": 45,
  "start": 108.12,
  "end": 108.72,
  "text": "Is that good?"
 },
 {
  "i": 46,
  "start": 109.14,
  "end": 109.92,
  "text": "It's right in the middle."
 },
 {
  "i": 47,
  "start": 110.4,
  "end": 110.46,
  "text": "Mid."
 },
 {
  "i": 48,
  "start": 110.84,
  "end": 110.98,
  "text": "Cool."
 },
 {
  "i": 49,
  "start": 111.36,
  "end": 111.8,
  "text": "Cool, cool, cool."
 },
 {
  "i": 50,
  "start": 112.18,
  "end": 112.82,
  "text": "He eats a fry."
 },
 {
  "i": 51,
  "start": 113.2,
  "end": 113.52,
  "text": "What's yours?"
 },
 {
  "i": 52,
  "start": 114.02,
  "end": 114.64,
  "text": "You don't answer."
 },
 {
  "i": 53,
  "start": 115.04,
  "end": 116.16,
  "text": "So, you keep testing."
 },
 {
  "i": 54,
  "start": 116.16,
  "end": 121.42,
  "text": "Your economics professor, who has 3 degrees and wrote the textbook, 1 .45 billion."
 },
 {
  "i": 55,
  "start": 121.96,
  "end": 122.76,
  "text": "Not looks either."
 },
 {
  "i": 56,
  "start": 123.18,
  "end": 125.26,
  "text": "Half the athletes in the gym are in the billions."
 },
 {
  "i": 57,
  "start": 125.66,
  "end": 128.9,
  "text": "And a guy with spaghetti sauce on his shirt is number 80 ,000."
 },
 {
  "i": 58,
  "start": 129.34,
  "end": 133.5,
  "text": "The barista who always remembers your name, 640 ,000."
 },
 {
  "i": 59,
  "start": 133.74,
  "end": 136.28,
  "text": "He's never once spelled it right, but he remembers it."
 },
 {
  "i": 60,
  "start": 136.6,
  "end": 142.06,
  "text": "And the guy who plays loud music on the bus every morning without headphones, 7 .99 billion."
 },
 {
  "i": 61,
  "start": 142.54,
  "end": 144.32,
  "text": "You feel very good about that one."
 },
 {
  "i": 62,
  "start": 144.32,
  "end": 146.42,
  "text": "Okay, Dev says, do me."
 },
 {
  "i": 63,
  "start": 146.76,
  "end": 147.38,
  "text": "What's my thing?"
 },
 {
  "i": 64,
  "start": 147.68,
  "end": 148.98,
  "text": "Why am I 2 .2?"
 },
 {
  "i": 65,
  "start": 149.32,
  "end": 150.1,
  "text": "I don't know yet."
 },
 {
  "i": 66,
  "start": 150.36,
  "end": 151.08,
  "text": "That's the problem."
 },
 {
  "i": 67,
  "start": 151.54,
  "end": 154.14,
  "text": "I can see the score, but nobody told me the game."
 },
 {
  "i": 68,
  "start": 154.6,
  "end": 155.14,
  "text": "Did it go up?"
 },
 {
  "i": 69,
  "start": 155.6,
  "end": 155.78,
  "text": "No."
 },
 {
  "i": 70,
  "start": 156.2,
  "end": 157.18,
  "text": "I was sitting up straight."
 },
 {
  "i": 71,
  "start": 157.52,
  "end": 158.72,
  "text": "It's not posture, Dev."
 },
 {
  "i": 72,
  "start": 159.24,
  "end": 163.44,
  "text": "And then, in the library, you see the one number you really didn't want to see."
 },
 {
  "i": 73,
  "start": 163.88,
  "end": 164.64,
  "text": "Then you see Maya."
 },
 {
  "i": 74,
  "start": 165.24,
  "end": 168.14,
  "text": "Third row of the library, same seat every Thursday."
 },
 {
  "i": 75,
  "start": 168.74,
  "end": 170.16,
  "text": "31 ,207."
 },
 {
  "i": 76,
  "start": 170.7,
  "end": 174.86,
  "text": "Out of 8 billion people, she's in the top 32 ,000."
 },
 {
  "i": 77,
  "start": 175.24,
  "end": 176.98,
  "text": "You are in the bottom billion."
 },
 {
  "i": 78,
  "start": 177.42,
  "end": 180.4,
  "text": "If the ranking means anything, she is way out of your league."
 },
 {
  "i": 79,
  "start": 181.04,
  "end": 182.26,
  "text": "Bro, go talk to her!"
 },
 {
  "i": 80,
  "start": 182.64,
  "end": 183.9,
  "text": "She's 31 ,000."
 },
 {
  "i": 81,
  "start": 184.38,
  "end": 187.2,
  "text": "I don't know what that means, but it sounds like a lot of thousands."
 },
 {
  "i": 82,
  "start": 187.66,
  "end": 187.86,
  "text": "Go!"
 },
 {
  "i": 83,
  "start": 188.32,
  "end": 189.02,
  "text": "You walk over."
 },
 {
  "i": 84,
  "start": 189.4,
  "end": 192.74,
  "text": "On the way, a freshman drops her pen and you hand it back without thinking."
 },
 {
  "i": 85,
  "start": 193.1,
  "end": 194.44,
  "text": "And then you notice something strange."
 },
 {
  "i": 86,
  "start": 194.96,
  "end": 196.0,
  "text": "Your number twitches."
 },
 {
  "i": 87,
  "start": 196.56,
  "end": 197.28,
  "text": "Just a few digits."
 },
 {
  "i": 88,
  "start": 197.8,
  "end": 198.92,
  "text": "It drops by 22."
 },
 {
  "i": 89,
  "start": 198.92,
  "end": 201.48,
  "text": "Hi, you're in my econ section, right?"
 },
 {
  "i": 90,
  "start": 201.86,
  "end": 204.56,
  "text": "You say the smoothest thing you've ever said in your life."
 },
 {
  "i": 91,
  "start": 205.02,
  "end": 207.18,
  "text": "Yes, section, econ, me."
 },
 {
  "i": 92,
  "start": 207.7,
  "end": 209.32,
  "text": "That twitch changes everything."
 },
 {
  "i": 93,
  "start": 209.84,
  "end": 212.06,
  "text": "If the number can move, you can move it."
 },
 {
  "i": 94,
  "start": 212.28,
  "end": 212.82,
  "text": "So you try."
 },
 {
  "i": 95,
  "start": 213.18,
  "end": 213.92,
  "text": "You go to the gym."
 },
 {
  "i": 96,
  "start": 214.38,
  "end": 214.6,
  "text": "Nothing."
 },
 {
  "i": 97,
  "start": 215.08,
  "end": 216.12,
  "text": "You get an A on your essay."
 },
 {
  "i": 98,
  "start": 216.6,
  "end": 216.84,
  "text": "Nothing."
 },
 {
  "i": 99,
  "start": 217.32,
  "end": 219.0,
  "text": "You spend half your savings on sneakers."
 },
 {
  "i": 100,
  "start": 219.68,
  "end": 219.88,
  "text": "Nothing."
 },
 {
  "i": 101,
  "start": 220.56,
  "end": 221.28,
  "text": "Dev claps anyway."
 },
 {
  "i": 102,
  "start": 221.84,
  "end": 226.12,
  "text": "Then, on the way out of the dining hall, you hold the door for a crowd of people carrying trays."
 },
 {
  "i": 103,
  "start": 226.5,
  "end": 228.72,
  "text": "And the number drops by almost 6 ,000!"
 },
 {
  "i": 104,
  "start": 228.72,
  "end": 230.08,
  "text": "You hold the door again."
 },
 {
  "i": 105,
  "start": 230.5,
  "end": 230.8,
  "text": "Nothing."
 },
 {
  "i": 106,
  "start": 231.24,
  "end": 232.0,
  "text": "The crowd is gone."
 },
 {
  "i": 107,
  "start": 232.34,
  "end": 234.54,
  "text": "It only counted when it actually helped someone."
 },
 {
  "i": 108,
  "start": 234.94,
  "end": 235.88,
  "text": "You run back to Dev."
 },
 {
  "i": 109,
  "start": 236.2,
  "end": 236.76,
  "text": "It moved!"
 },
 {
  "i": 110,
  "start": 237.06,
  "end": 238.2,
  "text": "It actually moved!"
 },
 {
  "i": 111,
  "start": 238.6,
  "end": 239.38,
  "text": "What did you do?"
 },
 {
  "i": 112,
  "start": 239.7,
  "end": 240.54,
  "text": "I held a door!"
 },
 {
  "i": 113,
  "start": 240.96,
  "end": 241.44,
  "text": "For who?"
 },
 {
  "i": 114,
  "start": 241.9,
  "end": 243.46,
  "text": "Like 12 people with trays."
 },
 {
  "i": 115,
  "start": 243.96,
  "end": 252.92,
  "text": "Dev thinks about this for exactly one second, then sprints to the dining hall and holds the door open for nobody, for 10 minutes, while people walk around him through the other door."
 },
 {
  "i": 116,
  "start": 253.26,
  "end": 254.24,
  "text": "His number doesn't move."
 },
 {
  "i": 117,
  "start": 254.66,
  "end": 255.3,
  "text": "Not even a little."
 },
 {
  "i": 118,
  "start": 255.8,
  "end": 257.02,
  "text": "It's broken, he says."
 },
 {
  "i": 119,
  "start": 257.34,
  "end": 258.14,
  "text": "It's not broken."
 },
 {
  "i": 120,
  "start": 258.14,
  "end": 260.18,
  "text": "You just don't understand it yet."
 },
 {
  "i": 121,
  "start": 260.82,
  "end": 262.76,
  "text": "That night, you finally figure it out."
 },
 {
  "i": 122,
  "start": 263.08,
  "end": 264.76,
  "text": "And it's so much worse than you thought."
 },
 {
  "i": 123,
  "start": 265.38,
  "end": 266.66,
  "text": "That night, you fill a notebook."
 },
 {
  "i": 124,
  "start": 267.32,
  "end": 267.64,
  "text": "The cleaner."
 },
 {
  "i": 125,
  "start": 268.1,
  "end": 268.52,
  "text": "The door."
 },
 {
  "i": 126,
  "start": 268.98,
  "end": 270.5,
  "text": "The richest kid who never tips."
 },
 {
  "i": 127,
  "start": 271.02,
  "end": 272.78,
  "text": "The number isn't measuring what you have."
 },
 {
  "i": 128,
  "start": 273.2,
  "end": 274.96,
  "text": "It's measuring what you do for other people."
 },
 {
  "i": 129,
  "start": 275.48,
  "end": 276.42,
  "text": "You remember the cleaner."
 },
 {
  "i": 130,
  "start": 276.9,
  "end": 279.12,
  "text": "You saw her hand a lost wallet back to a freshman."
 },
 {
  "i": 131,
  "start": 279.62,
  "end": 282.3,
  "text": "She's done that kind of thing every day for 30 years."
 },
 {
  "i": 132,
  "start": 282.86,
  "end": 283.76,
  "text": "And number 412?"
 },
 {
  "i": 133,
  "start": 284.54,
  "end": 285.34,
  "text": "A sleep in economics?"
 },
 {
  "i": 134,
  "start": 285.34,
  "end": 289.52,
  "text": "You find out later, he works nights as a hospital orderly to pay his tuition."
 },
 {
  "i": 135,
  "start": 290.02,
  "end": 290.68,
  "text": "He's not lazy."
 },
 {
  "i": 136,
  "start": 291.0,
  "end": 293.04,
  "text": "He's exhausted from looking after strangers."
 },
 {
  "i": 137,
  "start": 293.58,
  "end": 297.04,
  "text": "And Maya isn't sitting in the library every Thursday because she likes the chairs."
 },
 {
  "i": 138,
  "start": 297.46,
  "end": 299.06,
  "text": "She runs free tutoring for freshmen."
 },
 {
  "i": 139,
  "start": 299.48,
  "end": 301.24,
  "text": "That's why she's 31 ,000."
 },
 {
  "i": 140,
  "start": 301.46,
  "end": 303.1,
  "text": "Which raises a much worse question."
 },
 {
  "i": 141,
  "start": 303.46,
  "end": 309.28,
  "text": "If the number measures how much good you do, what have you been doing for 19 years to end up at 6 .9 billion?"
 },
 {
  "i": 142,
  "start": 309.86,
  "end": 310.78,
  "text": "You start remembering."
 },
 {
  "i": 143,
  "start": 311.16,
  "end": 316.22,
  "text": "The time you walked past someone carrying a box twice their size because you were late, even though you weren't."
 },
 {
  "i": 144,
  "start": 316.44,
  "end": 318.32,
  "text": "The calls from your mom you let go to voicemail."
 },
 {
  "i": 145,
  "start": 318.68,
  "end": 321.24,
  "text": "The notes you borrowed freshman year and never paid back."
 },
 {
  "i": 146,
  "start": 321.7,
  "end": 322.58,
  "text": "None of it was evil."
 },
 {
  "i": 147,
  "start": 322.94,
  "end": 323.52,
  "text": "That's the thing."
 },
 {
  "i": 148,
  "start": 323.82,
  "end": 325.34,
  "text": "You never did anything terrible."
 },
 {
  "i": 149,
  "start": 325.76,
  "end": 327.54,
  "text": "You just never did anything at all."
 },
 {
  "i": 150,
  "start": 327.96,
  "end": 331.8,
  "text": "And then, on the bus home, you see the lowest number you've ever seen."
 },
 {
  "i": 151,
  "start": 332.38,
  "end": 332.62,
  "text": "Three."
 },
 {
  "i": 152,
  "start": 333.2,
  "end": 333.94,
  "text": "The bus driver."
 },
 {
  "i": 153,
  "start": 334.36,
  "end": 337.68,
  "text": "He says good morning to every single person who gets on, by name."
 },
 {
  "i": 154,
  "start": 338.02,
  "end": 339.88,
  "text": "He waits for the student running late in the rain."
 },
 {
  "i": 155,
  "start": 340.2,
  "end": 345.0,
  "text": "He keeps a box of spare umbrellas under his seat and you've watched him give away five of them this month."
 },
 {
  "i": 156,
  "start": 345.46,
  "end": 345.92,
  "text": "Rough day, kid?"
 },
 {
  "i": 157,
  "start": 346.38,
  "end": 347.22,
  "text": "How do you..."
 },
 {
  "i": 158,
  "start": 347.22,
  "end": 348.42,
  "text": "Why do you do all this?"
 },
 {
  "i": 159,
  "start": 348.86,
  "end": 349.46,
  "text": "He shrugs."
 },
 {
  "i": 160,
  "start": 349.74,
  "end": 351.04,
  "text": "Somebody's got to make the bus nice."
 },
 {
  "i": 161,
  "start": 351.38,
  "end": 352.78,
  "text": "Might as well be the guy driving it."
 },
 {
  "i": 162,
  "start": 353.06,
  "end": 354.92,
  "text": "Number three on the entire planet."
 },
 {
  "i": 163,
  "start": 355.28,
  "end": 356.56,
  "text": "And he's never going to know."
 },
 {
  "i": 164,
  "start": 356.98,
  "end": 358.22,
  "text": "So now you know the rule."
 },
 {
  "i": 165,
  "start": 358.56,
  "end": 361.36,
  "text": "And knowing the rule turns out to be the most dangerous part."
 },
 {
  "i": 166,
  "start": 361.76,
  "end": 363.18,
  "text": "Here's the problem with knowing the rule."
 },
 {
  "i": 167,
  "start": 363.48,
  "end": 364.54,
  "text": "You start gaming it."
 },
 {
  "i": 168,
  "start": 364.7,
  "end": 366.88,
  "text": "You pick up litter, but only where people can see."
 },
 {
  "i": 169,
  "start": 367.18,
  "end": 369.84,
  "text": "You volunteer for one hour and post about it for three."
 },
 {
  "i": 170,
  "start": 370.12,
  "end": 373.72,
  "text": "You help an old man cross the street and he did not want to cross the street."
 },
 {
  "i": 171,
  "start": 374.18,
  "end": 375.18,
  "text": "The number doesn't move."
 },
 {
  "i": 172,
  "start": 375.56,
  "end": 376.1,
  "text": "Not once."
 },
 {
  "i": 173,
  "start": 376.5,
  "end": 378.34,
  "text": "It turns out it can tell the difference."
 },
 {
  "i": 174,
  "start": 379.04,
  "end": 380.24,
  "text": "You've been weird all week."
 },
 {
  "i": 175,
  "start": 380.72,
  "end": 381.46,
  "text": "You haven't slept."
 },
 {
  "i": 176,
  "start": 381.86,
  "end": 383.16,
  "text": "You keep looking at my head."
 },
 {
  "i": 177,
  "start": 383.52,
  "end": 385.54,
  "text": "And you tried to tutor the campus dog."
 },
 {
  "i": 178,
  "start": 386.06,
  "end": 387.6,
  "text": "I'm trying to be a better person."
 },
 {
  "i": 179,
  "start": 388.06,
  "end": 389.96,
  "text": "By yelling, you're welcome at strangers."
 },
 {
  "i": 180,
  "start": 390.74,
  "end": 392.38,
  "text": "Then the group project happens."
 },
 {
  "i": 181,
  "start": 393.04,
  "end": 393.96,
  "text": "Dev did half of it."
 },
 {
  "i": 182,
  "start": 394.32,
  "end": 395.74,
  "text": "Your name is on the title slide."
 },
 {
  "i": 183,
  "start": 396.18,
  "end": 398.04,
  "text": "His is in tiny letters at the bottom."
 },
 {
  "i": 184,
  "start": 398.42,
  "end": 401.92,
  "text": "The professor is about to hand out the grade and he asks who did the research."
 },
 {
  "i": 185,
  "start": 402.38,
  "end": 402.9,
  "text": "You could take"
 },
 {
  "i": 186,
  "start": 404.82,
  "end": 405.18,
  "text": "the..."
 },
 {
  "i": 187,
  "start": 405.18,
  "end": 406.38,
  "text": "Except the number would."
 },
 {
  "i": 188,
  "start": 407.0,
  "end": 407.7,
  "text": "Dev did the research."
 },
 {
  "i": 189,
  "start": 408.16,
  "end": 408.58,
  "text": "All of it."
 },
 {
  "i": 190,
  "start": 408.88,
  "end": 410.3,
  "text": "I just made the slides look nice."
 },
 {
  "i": 191,
  "start": 410.74,
  "end": 412.0,
  "text": "Your number starts falling."
 },
 {
  "i": 192,
  "start": 412.34,
  "end": 413.58,
  "text": "And not by a few digits."
 },
 {
  "i": 193,
  "start": 414.06,
  "end": 414.7,
  "text": "By billions."
 },
 {
  "i": 194,
  "start": 415.28,
  "end": 417.22,
  "text": "Because it was never about the one moment."
 },
 {
  "i": 195,
  "start": 417.6,
  "end": 420.92,
  "text": "It's every time you could have taken something and gave it away instead."
 },
 {
  "i": 196,
  "start": 421.44,
  "end": 425.74,
  "text": "Everyone you'd skipped for 19 years was still there, waiting to be counted."
 },
 {
  "i": 197,
  "start": 426.12,
  "end": 427.94,
  "text": "It stops at 1 .2 billion."
 },
 {
  "i": 198,
  "start": 428.48,
  "end": 429.28,
  "text": "Still not great."
 },
 {
  "i": 199,
  "start": 429.62,
  "end": 432.68,
  "text": "But for the first time, you know exactly how to change it."
 },
 {
  "i": 200,
  "start": 433.02,
  "end": 434.06,
  "text": "That was a nice thing you did."
 },
 {
  "i": 201,
  "start": 434.5,
  "end": 435.98,
  "text": "Most people would have just taken the grade."
 },
 {
  "i": 202,
  "start": 436.44,
  "end": 437.24,
  "text": "It was his work."
 },
 {
  "i": 203,
  "start": 437.76,
  "end": 438.96,
  "text": "Want to help with tutoring on Thursday?"
 },
 {
  "i": 204,
  "start": 439.4,
  "end": 440.7,
  "text": "We need someone who's good at econ."
 },
 {
  "i": 205,
  "start": 441.08,
  "end": 442.38,
  "text": "And at, um, section."
 },
 {
  "i": 206,
  "start": 442.92,
  "end": 443.14,
  "text": "Econ."
 },
 {
  "i": 207,
  "start": 443.46,
  "end": 443.6,
  "text": "Me."
 },
 {
  "i": 208,
  "start": 444.14,
  "end": 445.68,
  "text": "So, on Thursday you show up."
 },
 {
  "i": 209,
  "start": 445.98,
  "end": 450.26,
  "text": "A freshman named Priya is about to fail economics and is too embarrassed to ask anyone."
 },
 {
  "i": 210,
  "start": 450.62,
  "end": 453.12,
  "text": "You explain supply and demand using vending machines."
 },
 {
  "i": 211,
  "start": 453.56,
  "end": 455.28,
  "text": "Specifically the one that eats dollars."
 },
 {
  "i": 212,
  "start": 455.84,
  "end": 456.5,
  "text": "She gets it."
 },
 {
  "i": 213,
  "start": 456.78,
  "end": 461.42,
  "text": "And the look on her face when she gets it is better than anything you saw your number do all week."
 },
 {
  "i": 214,
  "start": 461.88,
  "end": 462.78,
  "text": "You don't check your number."
 },
 {
  "i": 215,
  "start": 463.2,
  "end": 465.22,
  "text": "For the first time, you forget it's there."
 },
 {
  "i": 216,
  "start": 465.76,
  "end": 467.3,
  "text": "Dev shows up with snacks for everyone."
 },
 {
  "i": 217,
  "start": 467.74,
  "end": 468.56,
  "text": "Nobody asked him to."
 },
 {
  "i": 218,
  "start": 468.98,
  "end": 469.8,
  "text": "His number twitches."
 },
 {
  "i": 219,
  "start": 470.32,
  "end": 470.88,
  "text": "Did it move?"
 },
 {
  "i": 220,
  "start": 471.28,
  "end": 471.62,
  "text": "He whispers."
 },
 {
  "i": 221,
  "start": 472.36,
  "end": 472.52,
  "text": "Yeah."
 },
 {
  "i": 222,
  "start": 472.96,
  "end": 473.66,
  "text": "Was it the snacks?"
 },
 {
  "i": 223,
  "start": 474.16,
  "end": 474.98,
  "text": "It was the snacks."
 },
 {
  "i": 224,
  "start": 475.42,
  "end": 476.98,
  "text": "He has never been happier."
 },
 {
  "i": 225,
  "start": 477.38,
  "end": 479.42,
  "text": "A week later you realize you've stopped checking."
 },
 {
  "i": 226,
  "start": 479.76,
  "end": 480.76,
  "text": "The number's still there."
 },
 {
  "i": 227,
  "start": 481.1,
  "end": 482.36,
  "text": "You just don't need it anymore."
 },
 {
  "i": 228,
  "start": 482.84,
  "end": 484.86,
  "text": "Dev is 1 .9 billion now."
 },
 {
  "i": 229,
  "start": 485.14,
  "end": 486.06,
  "text": "He's very proud."
 },
 {
  "i": 230,
  "start": 486.42,
  "end": 487.66,
  "text": "He made you write it on the fridge."
 },
 {
  "i": 231,
  "start": 487.66,
  "end": 490.54,
  "text": "And the vending machine is still 8 billion and 1."
 },
 {
  "i": 232,
  "start": 491.02,
  "end": 492.08,
  "text": "Some things never change."
 },
 {
  "i": 233,
  "start": 492.64,
  "end": 493.54,
  "text": "So here's my question."
 },
 {
  "i": 234,
  "start": 493.9,
  "end": 496.64,
  "text": "If you could see everyone's rank, would you want to see yours?"
 },
 {
  "i": 235,
  "start": 497.16,
  "end": 498.44,
  "text": "Or would you rather never know?"
 },
 {
  "i": 236,
  "start": 498.82,
  "end": 499.52,
  "text": "Tell me in the comments."
 }
]