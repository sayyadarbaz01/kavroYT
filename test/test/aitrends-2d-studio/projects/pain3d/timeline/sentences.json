[
 {
  "i": 0,
  "start": 0.3,
  "end": 3.66,
  "text": "You stub your toe against a solid steel bed frame."
 },
 {
  "i": 1,
  "start": 3.66,
  "end": 4.5,
  "text": "Hard."
 },
 {
  "i": 2,
  "start": 4.5,
  "end": 7.04,
  "text": "You brace for the agonizing sting."
 },
 {
  "i": 3,
  "start": 7.62,
  "end": 8.1,
  "text": "Nothing."
 },
 {
  "i": 4,
  "start": 9.28,
  "end": 10.42,
  "text": "Absolutely nothing."
 },
 {
  "i": 5,
  "start": 11.14,
  "end": 12.34,
  "text": "You do it again..."
 },
 {
  "i": 6,
  "start": 12.34,
  "end": 13.7,
  "text": "harder this time."
 },
 {
  "i": 7,
  "start": 13.7,
  "end": 14.76,
  "text": "No pain."
 },
 {
  "i": 8,
  "start": 15.3,
  "end": 17.68,
  "text": "You step on a Lego brick barefoot."
 },
 {
  "i": 9,
  "start": 17.68,
  "end": 19.18,
  "text": "Zero flinch."
 },
 {
  "i": 10,
  "start": 19.74,
  "end": 22.92,
  "text": "You grab a boiling hot pan right off the stove."
 },
 {
  "i": 11,
  "start": 23.46,
  "end": 24.86,
  "text": "Your hand sizzles..."
 },
 {
  "i": 12,
  "start": 24.86,
  "end": 26.84,
  "text": "but you feel zero pain."
 },
 {
  "i": 13,
  "start": 26.84,
  "end": 27.62,
  "text": "Bro!"
 },
 {
  "i": 14,
  "start": 27.62,
  "end": 28.84,
  "text": "Drop the pan!"
 },
 {
  "i": 15,
  "start": 28.84,
  "end": 30.98,
  "text": "Jay screams from the kitchen doorway."
 },
 {
  "i": 16,
  "start": 30.98,
  "end": 31.72,
  "text": "What?"
 },
 {
  "i": 17,
  "start": 31.72,
  "end": 32.98,
  "text": "It does not hurt!"
 },
 {
  "i": 18,
  "start": 32.98,
  "end": 34.18,
  "text": "Look at your palm..."
 },
 {
  "i": 19,
  "start": 34.18,
  "end": 35.48,
  "text": "it is turning red!"
 },
 {
  "i": 20,
  "start": 35.48,
  "end": 39.7,
  "text": "A normal human brain receives pain signals in ten milliseconds."
 },
 {
  "i": 21,
  "start": 39.7,
  "end": 42.7,
  "text": "Pain is your body's emergency siren."
 },
 {
  "i": 22,
  "start": 42.7,
  "end": 43.42,
  "text": "You?"
 },
 {
  "i": 23,
  "start": 43.42,
  "end": 44.78,
  "text": "Zero sirens."
 },
 {
  "i": 24,
  "start": 44.78,
  "end": 47.7,
  "text": "Your pain receptors are completely dead."
 },
 {
  "i": 25,
  "start": 47.7,
  "end": 50.76,
  "text": "But your body follows one brutal rule."
 },
 {
  "i": 26,
  "start": 50.76,
  "end": 51.8,
  "text": "Pain is gone..."
 },
 {
  "i": 27,
  "start": 51.8,
  "end": 55.3,
  "text": "but physical damage remains one hundred percent real."
 },
 {
  "i": 28,
  "start": 55.3,
  "end": 57.2,
  "text": "You do not feel the damage..."
 },
 {
  "i": 29,
  "start": 57.2,
  "end": 59.08,
  "text": "until your body collapses."
 },
 {
  "i": 30,
  "start": 59.08,
  "end": 61.66,
  "text": "So what if you felt zero pain?"
 },
 {
  "i": 31,
  "start": 61.66,
  "end": 63.06,
  "text": "At first..."
 },
 {
  "i": 32,
  "start": 63.06,
  "end": 65.02,
  "text": "it feels like you are invincible."
 },
 {
  "i": 33,
  "start": 65.02,
  "end": 67.34,
  "text": "You play dodgeball in gym class."
 },
 {
  "i": 34,
  "start": 67.34,
  "end": 71.12,
  "text": "A fifty kilometer an hour throw hits you square in the face."
 },
 {
  "i": 35,
  "start": 71.12,
  "end": 72.84,
  "text": "You do not even blink."
 },
 {
  "i": 36,
  "start": 72.84,
  "end": 75.52,
  "text": "You just smile and throw it back."
 },
 {
  "i": 37,
  "start": 75.52,
  "end": 78.58,
  "text": "You win thirty arm-wrestling matches in a row."
 },
 {
  "i": 38,
  "start": 78.58,
  "end": 79.22,
  "text": "How?"
 },
 {
  "i": 39,
  "start": 79.22,
  "end": 80.98,
  "text": "Because when your muscles tear..."
 },
 {
  "i": 40,
  "start": 80.98,
  "end": 83.28,
  "text": "your brain does not force you to quit."
 },
 {
  "i": 41,
  "start": 83.8,
  "end": 87.06,
  "text": "You let your arm bend backward without flinching."
 },
 {
  "i": 42,
  "start": 87.06,
  "end": 87.6,
  "text": "Stop!"
 },
 {
  "i": 43,
  "start": 87.6,
  "end": 89.5,
  "text": "You are going to snap your elbow!"
 },
 {
  "i": 44,
  "start": 89.5,
  "end": 90.46,
  "text": "Jay yells..."
 },
 {
  "i": 45,
  "start": 90.46,
  "end": 91.78,
  "text": "hiding his eyes."
 },
 {
  "i": 46,
  "start": 92.36,
  "end": 92.98,
  "text": "Relax..."
 },
 {
  "i": 47,
  "start": 93.04,
  "end": 94.22,
  "text": "I am fine!"
 },
 {
  "i": 48,
  "start": 94.22,
  "end": 96.32,
  "text": "Plus: zero fear."
 },
 {
  "i": 49,
  "start": 96.32,
  "end": 98.04,
  "text": "Pain causes fear."
 },
 {
  "i": 50,
  "start": 98.04,
  "end": 99.12,
  "text": "Without pain..."
 },
 {
  "i": 51,
  "start": 99.12,
  "end": 100.42,
  "text": "you are fearless."
 },
 {
  "i": 52,
  "start": 100.42,
  "end": 103.84,
  "text": "You jump off a three-meter wall without hesitating."
 },
 {
  "i": 53,
  "start": 103.84,
  "end": 107.62,
  "text": "You walk through a patch of stinging nettles like it is soft grass."
 },
 {
  "i": 54,
  "start": 107.62,
  "end": 110.94,
  "text": "You eat the hottest ghost pepper in the world."
 },
 {
  "i": 55,
  "start": 110.94,
  "end": 112.2,
  "text": "Your eyes water..."
 },
 {
  "i": 56,
  "start": 112.24,
  "end": 114.0,
  "text": "but you do not feel the burn."
 },
 {
  "i": 57,
  "start": 114.0,
  "end": 115.68,
  "text": "Is this spicy?"
 },
 {
  "i": 58,
  "start": 115.68,
  "end": 118.28,
  "text": "Jay stares at you in sheer horror."
 },
 {
  "i": 59,
  "start": 118.6,
  "end": 119.92,
  "text": "You are a monster!"
 },
 {
  "i": 60,
  "start": 119.92,
  "end": 123.36,
  "text": "Minus: the silent biological nightmare."
 },
 {
  "i": 61,
  "start": 123.36,
  "end": 125.26,
  "text": "Pain is not your enemy..."
 },
 {
  "i": 62,
  "start": 125.26,
  "end": 127.0,
  "text": "pain is your protector."
 },
 {
  "i": 63,
  "start": 127.0,
  "end": 128.14,
  "text": "Without pain..."
 },
 {
  "i": 64,
  "start": 128.14,
  "end": 130.38,
  "text": "you become your own worst enemy."
 },
 {
  "i": 65,
  "start": 131.02,
  "end": 132.34,
  "text": "While eating pizza..."
 },
 {
  "i": 66,
  "start": 132.34,
  "end": 135.34,
  "text": "you accidentally chew straight through your inner cheek."
 },
 {
  "i": 67,
  "start": 135.34,
  "end": 136.56,
  "text": "You do not notice..."
 },
 {
  "i": 68,
  "start": 136.56,
  "end": 139.82,
  "text": "until Jay points at the blood dripping onto your shirt."
 },
 {
  "i": 69,
  "start": 139.82,
  "end": 140.38,
  "text": "Mate!"
 },
 {
  "i": 70,
  "start": 140.38,
  "end": 141.56,
  "text": "Stop chewing!"
 },
 {
  "i": 71,
  "start": 142.52,
  "end": 146.54,
  "text": "You walk around on a fractured heel bone for four days."
 },
 {
  "i": 72,
  "start": 146.54,
  "end": 147.2,
  "text": "Why?"
 },
 {
  "i": 73,
  "start": 147.2,
  "end": 149.62,
  "text": "Because you thought your shoe was just tight."
 },
 {
  "i": 74,
  "start": 149.62,
  "end": 152.46,
  "text": "You do not notice your appendix is about to burst..."
 },
 {
  "i": 75,
  "start": 152.46,
  "end": 155.66,
  "text": "until you faint on the kitchen floor from internal shock."
 },
 {
  "i": 76,
  "start": 155.66,
  "end": 158.06,
  "text": "Your body is screaming for help..."
 },
 {
  "i": 77,
  "start": 158.06,
  "end": 160.28,
  "text": "but the alarm system is disconnected."
 },
 {
  "i": 78,
  "start": 161.38,
  "end": 164.02,
  "text": "Even worse: thermal destruction."
 },
 {
  "i": 79,
  "start": 164.02,
  "end": 166.38,
  "text": "You sit near a campfire in the winter."
 },
 {
  "i": 80,
  "start": 166.38,
  "end": 168.98,
  "text": "Your legs feel nice and warm."
 },
 {
  "i": 81,
  "start": 168.98,
  "end": 172.92,
  "text": "But your skin is quietly suffering third-degree burns."
 },
 {
  "i": 82,
  "start": 172.92,
  "end": 176.72,
  "text": "You do not smell the smoke until your pants start charring."
 },
 {
  "i": 83,
  "start": 176.72,
  "end": 179.38,
  "text": "You cannot tell if water is warm or boiling."
 },
 {
  "i": 84,
  "start": 179.38,
  "end": 183.36,
  "text": "You cannot tell if ice is cold or freezing your cells to death."
 },
 {
  "i": 85,
  "start": 183.36,
  "end": 185.3,
  "text": "Your skin fights a war..."
 },
 {
  "i": 86,
  "start": 185.3,
  "end": 186.9,
  "text": "with zero warnings."
 },
 {
  "i": 87,
  "start": 186.9,
  "end": 191.04,
  "text": "Your best friend Jay realizes you are a walking hazard."
 },
 {
  "i": 88,
  "start": 191.04,
  "end": 194.0,
  "text": "He becomes your full-time human sensor."
 },
 {
  "i": 89,
  "start": 194.0,
  "end": 196.68,
  "text": "He buys a medical flashlight and a mirror."
 },
 {
  "i": 90,
  "start": 196.68,
  "end": 199.12,
  "text": "Every single night at eight o'clock..."
 },
 {
  "i": 91,
  "start": 199.12,
  "end": 201.36,
  "text": "Jay conducts a full-body inspection."
 },
 {
  "i": 92,
  "start": 202.06,
  "end": 203.12,
  "text": "Turn around."
 },
 {
  "i": 93,
  "start": 203.12,
  "end": 204.32,
  "text": "Show me your elbows."
 },
 {
  "i": 94,
  "start": 204.32,
  "end": 205.44,
  "text": "Check your heels."
 },
 {
  "i": 95,
  "start": 205.44,
  "end": 207.92,
  "text": "Jay writes down every scratch..."
 },
 {
  "i": 96,
  "start": 207.92,
  "end": 209.32,
  "text": "every bruise..."
 },
 {
  "i": 97,
  "start": 209.32,
  "end": 211.26,
  "text": "and every burn in a notebook."
 },
 {
  "i": 98,
  "start": 211.26,
  "end": 218.24,
  "text": "He makes a custom leather band for your wrist with four words stamped into it: Keep Check Your Skin, Leo."
 },
 {
  "i": 99,
  "start": 218.24,
  "end": 219.66,
  "text": "Your name is Leo."
 },
 {
  "i": 100,
  "start": 220.3,
  "end": 222.48,
  "text": "You wear that wristband everywhere."
 },
 {
  "i": 101,
  "start": 222.48,
  "end": 224.14,
  "text": "You make a joke out of it."
 },
 {
  "i": 102,
  "start": 224.14,
  "end": 224.98,
  "text": "What are you..."
 },
 {
  "i": 103,
  "start": 224.98,
  "end": 225.7,
  "text": "my mom?"
 },
 {
  "i": 104,
  "start": 226.22,
  "end": 229.18,
  "text": "Someone has to keep you from accidentally blowing up your own body!"
 },
 {
  "i": 105,
  "start": 229.18,
  "end": 232.22,
  "text": "Then comes a freezing Thursday evening."
 },
 {
  "i": 106,
  "start": 232.22,
  "end": 235.62,
  "text": "You and Jay walk past an abandoned apartment building."
 },
 {
  "i": 107,
  "start": 235.62,
  "end": 238.56,
  "text": "Black smoke pours from the second floor."
 },
 {
  "i": 108,
  "start": 238.56,
  "end": 240.86,
  "text": "A mother screams from the sidewalk."
 },
 {
  "i": 109,
  "start": 240.86,
  "end": 242.46,
  "text": "My baby is inside!"
 },
 {
  "i": 110,
  "start": 243.38,
  "end": 245.04,
  "text": "Firefighters are five minutes away."
 },
 {
  "i": 111,
  "start": 245.04,
  "end": 248.24,
  "text": "The wooden staircase is already collapsing in flames."
 },
 {
  "i": 112,
  "start": 248.24,
  "end": 250.06,
  "text": "You do not hesitate."
 },
 {
  "i": 113,
  "start": 250.06,
  "end": 252.38,
  "text": "You sprint into the burning building."
 },
 {
  "i": 114,
  "start": 252.38,
  "end": 252.94,
  "text": "Leo!"
 },
 {
  "i": 115,
  "start": 252.94,
  "end": 253.62,
  "text": "Stop!"
 },
 {
  "i": 116,
  "start": 253.62,
  "end": 255.78,
  "text": "You do not have super healing!"
 },
 {
  "i": 117,
  "start": 255.78,
  "end": 257.26,
  "text": "Jay shouts from the street."
 },
 {
  "i": 118,
  "start": 257.26,
  "end": 259.12,
  "text": "But you do not feel fear..."
 },
 {
  "i": 119,
  "start": 259.12,
  "end": 261.46,
  "text": "because you do not feel pain."
 },
 {
  "i": 120,
  "start": 261.46,
  "end": 263.62,
  "text": "You crash through a burning door."
 },
 {
  "i": 121,
  "start": 263.62,
  "end": 265.82,
  "text": "Intense heat surrounds you."
 },
 {
  "i": 122,
  "start": 265.82,
  "end": 268.22,
  "text": "Toxic smoke fills your lungs."
 },
 {
  "i": 123,
  "start": 268.22,
  "end": 271.8,
  "text": "Normal humans would fall to their knees from the searing pain."
 },
 {
  "i": 124,
  "start": 271.8,
  "end": 272.5,
  "text": "You?"
 },
 {
  "i": 125,
  "start": 272.5,
  "end": 275.18,
  "text": "You walk straight through the inferno."
 },
 {
  "i": 126,
  "start": 275.18,
  "end": 277.78,
  "text": "You find the little girl hiding under a bed."
 },
 {
  "i": 127,
  "start": 277.78,
  "end": 279.76,
  "text": "You wrap her in a wet blanket."
 },
 {
  "i": 128,
  "start": 279.76,
  "end": 282.14,
  "text": "Flaming timber crashes onto your back."
 },
 {
  "i": 129,
  "start": 282.14,
  "end": 282.74,
  "text": "CRACK!"
 },
 {
  "i": 130,
  "start": 282.74,
  "end": 284.48,
  "text": "Your jacket catches fire."
 },
 {
  "i": 131,
  "start": 284.48,
  "end": 286.72,
  "text": "Your skin blisters instantly."
 },
 {
  "i": 132,
  "start": 286.72,
  "end": 288.06,
  "text": "You feel nothing."
 },
 {
  "i": 133,
  "start": 288.06,
  "end": 289.42,
  "text": "Zero pain."
 },
 {
  "i": 134,
  "start": 289.42,
  "end": 293.08,
  "text": "But your heart races at one hundred and ninety beats per minute."
 },
 {
  "i": 135,
  "start": 293.08,
  "end": 296.02,
  "text": "Your body is going into silent thermal shock."
 },
 {
  "i": 136,
  "start": 296.02,
  "end": 299.08,
  "text": "You burst through the front door into the icy night air!"
 },
 {
  "i": 137,
  "start": 299.08,
  "end": 300.8,
  "text": "You hand the child to her mother."
 },
 {
  "i": 138,
  "start": 300.8,
  "end": 303.52,
  "text": "You collapse onto the freezing grass."
 },
 {
  "i": 139,
  "start": 303.52,
  "end": 306.06,
  "text": "Jay rushes over with a fire extinguisher."
 },
 {
  "i": 140,
  "start": 306.06,
  "end": 307.32,
  "text": "He sprays your back."
 },
 {
  "i": 141,
  "start": 307.32,
  "end": 308.54,
  "text": "He checks your pulse."
 },
 {
  "i": 142,
  "start": 308.54,
  "end": 309.06,
  "text": "Leo!"
 },
 {
  "i": 143,
  "start": 309.06,
  "end": 310.0,
  "text": "Stay awake!"
 },
 {
  "i": 144,
  "start": 310.0,
  "end": 311.0,
  "text": "Look at me!"
 },
 {
  "i": 145,
  "start": 311.3,
  "end": 313.34,
  "text": "I do not feel anything..."
 },
 {
  "i": 146,
  "start": 313.34,
  "end": 314.7,
  "text": "That is the problem!"
 },
 {
  "i": 147,
  "start": 314.7,
  "end": 316.1,
  "text": "You are burning up!"
 },
 {
  "i": 148,
  "start": 316.1,
  "end": 320.58,
  "text": "Jay wraps you in emergency blankets and pours ice water over your shoulders."
 },
 {
  "i": 149,
  "start": 321.38,
  "end": 322.62,
  "text": "You survive..."
 },
 {
  "i": 150,
  "start": 322.62,
  "end": 326.38,
  "text": "because Jay checked your body before shock took your life."
 },
 {
  "i": 151,
  "start": 326.38,
  "end": 328.0,
  "text": "Is any of this real?"
 },
 {
  "i": 152,
  "start": 328.0,
  "end": 328.82,
  "text": "Yes."
 },
 {
  "i": 153,
  "start": 329.46,
  "end": 332.02,
  "text": "This real-world medical condition exists."
 },
 {
  "i": 154,
  "start": 332.64,
  "end": 335.44,
  "text": "It is called Congenital Insensitivity to Pain..."
 },
 {
  "i": 155,
  "start": 335.44,
  "end": 337.24,
  "text": "or C-I-P."
 },
 {
  "i": 156,
  "start": 337.24,
  "end": 343.52,
  "text": "People born with mutations in the S-C-N-nine-A gene produce zero pain signals."
 },
 {
  "i": 157,
  "start": 343.52,
  "end": 347.08,
  "text": "Children with C-I-P often bite their own tongues..."
 },
 {
  "i": 158,
  "start": 347.08,
  "end": 349.0,
  "text": "fracture bones without knowing..."
 },
 {
  "i": 159,
  "start": 349.0,
  "end": 352.24,
  "text": "and must wear protective goggles to prevent eye damage."
 },
 {
  "i": 160,
  "start": 352.24,
  "end": 354.08,
  "text": "Pain is not a curse..."
 },
 {
  "i": 161,
  "start": 354.08,
  "end": 355.86,
  "text": "it is human survival."
 },
 {
  "i": 162,
  "start": 356.52,
  "end": 357.48,
  "text": "That night..."
 },
 {
  "i": 163,
  "start": 357.48,
  "end": 360.02,
  "text": "you sit on your bed covered in bandages."
 },
 {
  "i": 164,
  "start": 360.02,
  "end": 361.68,
  "text": "Your phone vibrates."
 },
 {
  "i": 165,
  "start": 361.68,
  "end": 363.08,
  "text": "A video clip plays."
 },
 {
  "i": 166,
  "start": 363.08,
  "end": 365.96,
  "text": "A black van sits under your streetlight."
 },
 {
  "i": 167,
  "start": 365.96,
  "end": 369.38,
  "text": "A woman in a gray coat looks straight into the camera."
 },
 {
  "i": 168,
  "start": 369.38,
  "end": 371.66,
  "text": "We have a boy who stops time."
 },
 {
  "i": 169,
  "start": 371.66,
  "end": 373.58,
  "text": "We have a boy who teleports."
 },
 {
  "i": 170,
