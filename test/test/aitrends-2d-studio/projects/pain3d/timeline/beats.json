[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.3,
  "speechEnd": 4.5,
  "text": "You stub your toe against a solid steel bed frame. Hard.",
  "end": 4.35
 },
 {
  "i": 1,
  "start": 4.35,
  "speechStart": 4.5,
  "speechEnd": 10.42,
  "text": "You brace for the agonizing sting. Nothing. Absolutely nothing.",
  "end": 10.99
 },
 {
  "i": 2,
  "start": 10.99,
  "speechStart": 11.14,
  "speechEnd": 12.34,
  "text": "You do it again...",
  "end": 12.19
 },
 {
  "i": 3,
  "start": 12.19,
  "speechStart": 12.34,
  "speechEnd": 14.76,
  "text": "harder this time. No pain.",
  "end": 15.15
 },
 {
  "i": 4,
  "start": 15.15,
  "speechStart": 15.3,
  "speechEnd": 17.68,
  "text": "You step on a Lego brick barefoot.",
  "end": 17.53
 },
 {
  "i": 5,
  "start": 17.53,
  "speechStart": 17.68,
  "speechEnd": 19.18,
  "text": "Zero flinch.",
  "end": 19.59
 },
 {
  "i": 6,
  "start": 19.59,
  "speechStart": 19.74,
  "speechEnd": 22.92,
  "text": "You grab a boiling hot pan right off the stove.",
  "end": 23.31
 },
 {
  "i": 7,
  "start": 23.31,
  "speechStart": 23.46,
  "speechEnd": 24.86,
  "text": "Your hand sizzles...",
  "end": 24.71
 },
 {
  "i": 8,
  "start": 24.71,
  "speechStart": 24.86,
  "speechEnd": 27.62,
  "text": "but you feel zero pain. Bro!",
  "end": 27.47
 },
 {
  "i": 9,
  "start": 27.47,
  "speechStart": 27.62,
  "speechEnd": 28.84,
  "text": "Drop the pan!",
  "end": 28.69
 },
 {
  "i": 10,
  "start": 28.69,
  "speechStart": 28.84,
  "speechEnd": 31.72,
  "text": "Jay screams from the kitchen doorway. What?",
  "end": 31.57
 },
 {
  "i": 11,
  "start": 31.57,
  "speechStart": 31.72,
  "speechEnd": 32.98,
  "text": "It does not hurt!",
  "end": 32.83
 },
 {
  "i": 12,
  "start": 32.83,
  "speechStart": 32.98,
  "speechEnd": 34.18,
  "text": "Look at your palm...",
  "end": 34.03
 },
 {
  "i": 13,
  "start": 34.03,
  "speechStart": 34.18,
  "speechEnd": 35.48,
  "text": "it is turning red!",
  "end": 35.33
 },
 {
  "i": 14,
  "start": 35.33,
  "speechStart": 35.48,
  "speechEnd": 39.7,
  "text": "A normal human brain receives pain signals in ten milliseconds.",
  "end": 39.55
 },
 {
  "i": 15,
  "start": 39.55,
  "speechStart": 39.7,
  "speechEnd": 43.42,
  "text": "Pain is your body's emergency siren. You?",
  "end": 43.27
 },
 {
  "i": 16,
  "start": 43.27,
  "speechStart": 43.42,
  "speechEnd": 44.78,
  "text": "Zero sirens.",
  "end": 44.63
 },
 {
  "i": 17,
  "start": 44.63,
  "speechStart": 44.78,
  "speechEnd": 47.7,
  "text": "Your pain receptors are completely dead.",
  "end": 47.55
 },
 {
  "i": 18,
  "start": 47.55,
  "speechStart": 47.7,
  "speechEnd": 51.8,
  "text": "But your body follows one brutal rule. Pain is gone...",
  "end": 51.65
 },
 {
  "i": 19,
  "start": 51.65,
  "speechStart": 51.8,
  "speechEnd": 55.3,
  "text": "but physical damage remains one hundred percent real.",
  "end": 55.15
 },
 {
  "i": 20,
  "start": 55.15,
  "speechStart": 55.3,
  "speechEnd": 57.2,
  "text": "You do not feel the damage...",
  "end": 57.05
 },
 {
  "i": 21,
  "start": 57.05,
  "speechStart": 57.2,
  "speechEnd": 59.08,
  "text": "until your body collapses.",
  "end": 58.93
 },
 {
  "i": 22,
  "start": 58.93,
  "speechStart": 59.08,
  "speechEnd": 61.66,
  "text": "So what if you felt zero pain?",
  "end": 61.51
 },
 {
  "i": 23,
  "start": 61.51,
  "speechStart": 61.66,
  "speechEnd": 63.06,
  "text": "At first...",
  "end": 62.91
 },
 {
  "i": 24,
  "start": 62.91,
  "speechStart": 63.06,
  "speechEnd": 65.02,
  "text": "it feels like you are invincible.",
  "end": 64.87
 },
 {
  "i": 25,
  "start": 64.87,
  "speechStart": 65.02,
  "speechEnd": 67.34,
  "text": "You play dodgeball in gym class.",
  "end": 67.19
 },
 {
  "i": 26,
  "start": 67.19,
  "speechStart": 67.34,
  "speechEnd": 71.12,
  "text": "A fifty kilometer an hour throw hits you square in the face.",
  "end": 70.97
 },
 {
  "i": 27,
  "start": 70.97,
  "speechStart": 71.12,
  "speechEnd": 72.84,
  "text": "You do not even blink.",
  "end": 72.69
 },
 {
  "i": 28,
  "start": 72.69,
  "speechStart": 72.84,
  "speechEnd": 75.52,
  "text": "You just smile and throw it back.",
  "end": 75.37
 },
 {
  "i": 29,
  "start": 75.37,
  "speechStart": 75.52,
  "speechEnd": 79.22,
  "text": "You win thirty arm-wrestling matches in a row. How?",
  "end": 79.07
 },
 {
  "i": 30,
  "start": 79.07,
  "speechStart": 79.22,
  "speechEnd": 80.98,
  "text": "Because when your muscles tear...",
  "end": 80.83
 },
 {
  "i": 31,
  "start": 80.83,
  "speechStart": 80.98,
  "speechEnd": 83.28,
  "text": "your brain does not force you to quit.",
  "end": 83.65
 },
 {
  "i": 32,
  "start": 83.65,
  "speechStart": 83.8,
  "speechEnd": 87.6,
  "text": "You let your arm bend backward without flinching. Stop!",
  "end": 87.45
 },
 {
  "i": 33,
  "start": 87.45,
  "speechStart": 87.6,
  "speechEnd": 90.46,
  "text": "You are going to snap your elbow! Jay yells...",
  "end": 90.31
 },
 {
  "i": 34,
  "start": 90.31,
  "speechStart": 90.46,
  "speechEnd": 95.04,
  "text": "hiding his eyes. Relax... I am fine! Plus:",
  "end": 94.89
 },
 {
  "i": 35,
  "start": 94.89,
  "speechStart": 95.04,
  "speechEnd": 96.32,
  "text": "zero fear.",
  "end": 96.17
 },
 {
  "i": 36,
  "start": 96.17,
  "speechStart": 96.32,
  "speechEnd": 99.12,
  "text": "Pain causes fear. Without pain...",
  "end": 98.97
 },
 {
  "i": 37,
  "start": 98.97,
  "speechStart": 99.12,
  "speechEnd": 100.42,
  "text": "you are fearless.",
  "end": 100.27
 },
 {
  "i": 38,
  "start": 100.27,
  "speechStart": 100.42,
  "speechEnd": 103.84,
  "text": "You jump off a three-meter wall without hesitating.",
  "end": 103.69
 },
 {
  "i": 39,
  "start": 103.69,
  "speechStart": 103.84,
  "speechEnd": 107.62,
  "text": "You walk through a patch of stinging nettles like it is soft grass.",
  "end": 107.47
 },
 {
  "i": 40,
  "start": 107.47,
  "speechStart": 107.62,
  "speechEnd": 110.94,
  "text": "You eat the hottest ghost pepper in the world.",
  "end": 110.79
 },
 {
  "i": 41,
  "start": 110.79,
  "speechStart": 110.94,
  "speechEnd": 112.2,
  "text": "Your eyes water...",
  "end": 112.09
 },
 {
  "i": 42,
  "start": 112.09,
  "speechStart": 112.24,
  "speechEnd": 114.0,
  "text": "but you do not feel the burn.",
  "end": 113.85
 },
 {
  "i": 43,
  "start": 113.85,
  "speechStart": 114.0,
  "speechEnd": 115.68,
  "text": "Is this spicy?",
  "end": 115.53
 },
 {
  "i": 44,
  "start": 115.53,
  "speechStart": 115.68,
  "speechEnd": 118.28,
  "text": "Jay stares at you in sheer horror.",
  "end": 118.45
 },
 {
  "i": 45,
  "start": 118.45,
  "speechStart": 118.6,
  "speechEnd": 120.8,
  "text": "You are a monster! Minus:",
  "end": 120.65
 },
 {
  "i": 46,
  "start": 120.65,
  "speechStart": 120.8,
  "speechEnd": 123.36,
  "text": "the silent biological nightmare.",
  "end": 123.21
 },
 {
  "i": 47,
  "start": 123.21,
  "speechStart": 123.36,
  "speechEnd": 125.26,
  "text": "Pain is not your enemy...",
  "end": 125.11
 },
 {
  "i": 48,
  "start": 125.11,
  "speechStart": 125.26,
  "speechEnd": 128.14,
  "text": "pain is your protector. Without pain...",
  "end": 127.99
 },
 {
  "i": 49,
  "start": 127.99,
  "speechStart": 128.14,
  "speechEnd": 130.38,
  "text": "you become your own worst enemy.",
  "end": 130.87
 },
 {
  "i": 50,
  "start": 130.87,
  "speechStart": 131.02,
  "speechEnd": 132.34,
  "text": "While eating pizza...",
  "end": 132.19
 },
 {
  "i": 51,
  "start": 132.19,
  "speechStart": 132.34,
  "speechEnd": 135.34,
  "text": "you accidentally chew straight through your inner cheek.",
  "end": 135.19
 },
 {
  "i": 52,
  "start": 135.19,
  "speechStart": 135.34,
  "speechEnd": 136.56,
  "text": "You do not notice...",
  "end": 136.41
 },
 {
  "i": 53,
  "start": 136.41,
  "speechStart": 136.56,
  "speechEnd": 141.56,
  "text": "until Jay points at the blood dripping onto your shirt. Mate! Stop chewing!",
  "end": 142.37
 },
 {
  "i": 54,
  "start": 142.37,
  "speechStart": 142.52,
  "speechEnd": 147.2,
  "text": "You walk around on a fractured heel bone for four days. Why?",
  "end": 147.05
 },
 {
  "i": 55,
  "start": 147.05,
  "speechStart": 147.2,
  "speechEnd": 149.62,
  "text": "Because you thought your shoe was just tight.",
  "end": 149.47
 },
 {
  "i": 56,
  "start": 149.47,
  "speechStart": 149.62,
  "speechEnd": 152.46,
  "text": "You do not notice your appendix is about to burst...",
  "end": 152.31
 },
 {
  "i": 57,
  "start": 152.31,
  "speechStart": 152.46,
  "speechEnd": 155.66,
  "text": "until you faint on the kitchen floor from internal shock.",
  "end": 155.51
 },
 {
  "i": 58,
  "start": 155.51,
  "speechStart": 155.66,
  "speechEnd": 158.06,
  "text": "Your body is screaming for help...",
  "end": 157.91
 },
 {
  "i": 59,
  "start": 157.91,
  "speechStart": 158.06,
  "speechEnd": 162.46,
  "text": "but the alarm system is disconnected. Even worse:",
  "end": 162.31
 },
 {
  "i": 60,
  "start": 162.31,
  "speechStart": 162.46,
  "speechEnd": 164.02,
  "text": "thermal destruction.",
  "end": 163.87
 },
 {
  "i": 61,
  "start": 163.87,
  "speechStart": 164.02,
  "speechEnd": 166.38,
  "text": "You sit near a campfire in the winter.",
  "end": 166.23
 },
 {
  "i": 62,
  "start": 166.23,
  "speechStart": 166.38,
  "speechEnd": 168.98,
  "text": "Your legs feel nice and warm.",
  "end": 168.83
 },
 {
  "i": 63,
  "start": 168.83,
  "speechStart": 168.98,
  "speechEnd": 172.92,
  "text": "But your skin is quietly suffering third-degree burns.",
  "end": 172.77
 },
 {
  "i": 64,
  "start": 172.77,
  "speechStart": 172.92,
  "speechEnd": 176.72,
  "text": "You do not smell the smoke until your pants start charring.",
  "end": 176.57
 },
 {
  "i": 65,
  "start": 176.57,
  "speechStart": 176.72,
  "speechEnd": 179.38,
  "text": "You cannot tell if water is warm or boiling.",
  "end": 179.23
 },
 {
  "i": 66,
  "start": 179.23,
  "speechStart": 179.38,
  "speechEnd": 183.36,
  "text": "You cannot tell if ice is cold or freezing your cells to death.",
  "end": 183.21
 },
 {
  "i": 67,
  "start": 183.21,
  "speechStart": 183.36,
  "speechEnd": 185.3,
  "text": "Your skin fights a war...",
  "end": 185.15
 },
 {
  "i": 68,
  "start": 185.15,
  "speechStart": 185.3,
  "speechEnd": 186.9,
  "text": "with zero warnings.",
  "end": 186.75
 },
 {
  "i": 69,
  "start": 186.75,
  "speechStart": 186.9,
  "speechEnd": 191.04,
  "text": "Your best friend Jay realizes you are a walking hazard.",
  "end": 190.89
 },
 {
  "i": 70,
  "start": 190.89,
  "speechStart": 191.04,
  "speechEnd": 194.0,
  "text": "He becomes your full-time human sensor.",
  "end": 193.85
 },
 {
  "i": 71,
  "start": 193.85,
  "speechStart": 194.0,
  "speechEnd": 196.68,
  "text": "He buys a medical flashlight and a mirror.",
  "end": 196.53
 },
 {
  "i": 72,
  "start": 196.53,
  "speechStart": 196.68,
  "speechEnd": 199.12,
  "text": "Every single night at eight o'clock...",
  "end": 198.97
 },
 {
  "i": 73,
  "start": 198.97,
  "speechStart": 199.12,
  "speechEnd": 205.44,
  "text": "Jay conducts a full-body inspection. Turn around. Show me your elbows. Check your heels.",
  "end": 205.29
 },
 {
  "i": 74,
  "start": 205.29,
  "speechStart": 205.44,
  "speechEnd": 207.92,
  "text": "Jay writes down every scratch...",
  "end": 207.77
 },
 {
  "i": 75,
  "start": 207.77,
  "speechStart": 207.92,
  "speechEnd": 209.32,
  "text": "every bruise...",
  "end": 209.17
 },
 {
  "i": 76,
  "start": 209.17,
  "speechStart": 209.32,
  "speechEnd": 211.26,
  "text": "and every burn in a notebook.",
  "end": 211.11
 },
 {
  "i": 77,
  "start": 211.11,
  "speechStart": 211.26,
  "speechEnd": 216.22,
  "text": "He makes a custom leather band for your wrist with four words stamped into it:",
  "end": 216.07
 },
 {
  "i": 78,
  "start": 216.07,
  "speechStart": 216.22,
  "speechEnd": 218.24,
  "text": "Keep Check Your Skin, Leo.",
  "end": 218.09
 },
 {
  "i": 79,
  "start": 218.09,
  "speechStart": 218.24,
  "speechEnd": 219.66,
  "text": "Your name is Leo.",
  "end": 220.15
 },
 {
  "i": 80,
  "start": 220.15,
  "speechStart": 220.3,
  "speechEnd": 222.48,
  "text": "You wear that wristband everywhere.",
  "end": 222.33
 },
 {
  "i": 81,
  "start": 222.33,
  "speechStart": 222.48,
  "speechEnd": 225.7,
  "text": "You make a joke out of it. What are you... my mom?",
  "end": 226.07
 },
 {
  "i": 82,
  "start": 226.07,
  "speechStart": 226.22,
  "speechEnd": 229.18,
  "text": "Someone has to keep you from accidentally blowing up your own body!",
  "end": 229.03
 },
 {
  "i": 83,
  "start": 229.03,
  "speechStart": 229.18,
  "speechEnd": 232.22,
  "text": "Then comes a freezing Thursday evening.",
  "end": 232.07
 },
 {
  "i": 84,
  "start": 232.07,
  "speechStart": 232.22,
  "speechEnd": 235.62,
  "text": "You and Jay walk past an abandoned apartment building.",
  "end": 235.47
 },
 {
  "i": 85,
  "start": 235.47,
  "speechStart": 235.62,
  "speechEnd": 238.56,
  "text": "Black smoke pours from the second floor.",
  "end": 238.41
 },
 {
  "i": 86,
  "start": 238.41,
  "speechStart": 238.56,
  "speechEnd": 240.86,
  "text": "A mother screams from the sidewalk.",
  "end": 240.71
 },
 {
  "i": 87,
  "start": 240.71,
  "speechStart": 240.86,
  "speechEnd": 242.46,
  "text": "My baby is inside!",
  "end": 243.23
 },
 {
  "i": 88,
  "start": 243.23,
  "speechStart": 243.38,
  "speechEnd": 245.04,
  "text": "Firefighters are five minutes away.",
  "end": 244.89
 },
 {
  "i": 89,
  "start": 244.89,
  "speechStart": 245.04,
  "speechEnd": 248.24,
  "text": "The wooden staircase is already collapsing in flames.",
  "end": 248.09
 },
 {
  "i": 90,
  "start": 248.09,
  "speechStart": 248.24,
  "speechEnd": 250.06,
  "text": "You do not hesitate.",
  "end": 249.91
 },
 {
  "i": 91,
  "start": 249.91,
  "speechStart": 250.06,
  "speechEnd": 253.62,
  "text": "You sprint into the burning building. Leo! Stop!",
  "end": 253.47
 },
 {
  "i": 92,
  "start": 253.47,
  "speechStart": 253.62,
  "speechEnd": 255.78,
  "text": "You do not have super healing!",
  "end": 255.63
 },
 {
  "i": 93,
  "start": 255.63,
  "speechStart": 255.78,
  "speechEnd": 257.26,
  "text": "Jay shouts from the street.",
  "end": 257.11
 },
 {
  "i": 94,
  "start": 257.11,
  "speechStart": 257.26,
  "speechEnd": 259.12,
  "text": "But you do not feel fear...",
  "end": 258.97
 },
 {
  "i": 95,
  "start": 258.97,
  "speechStart": 259.12,
  "speechEnd": 261.46,
  "text": "because you do not feel pain.",
  "end": 261.31
 },
 {
  "i": 96,
  "start": 261.31,
  "speechStart": 261.46,
  "speechEnd": 263.62,
  "text": "You crash through a burning door.",
  "end": 263.47
 },
 {
  "i": 97,
  "start": 263.47,
  "speechStart": 263.62,
  "speechEnd": 265.82,
  "text": "Intense heat surrounds you.",
  "end": 265.67
 },
 {
  "i": 98,
  "start": 265.67,
  "speechStart": 265.82,
  "speechEnd": 268.22,
  "text": "Toxic smoke fills your lungs.",
  "end": 268.07
 },
 {
  "i": 99,
  "start": 268.07,
  "speechStart": 268.22,
  "speechEnd": 272.5,
  "text": "Normal humans would fall to their knees from the searing pain. You?",
  "end": 272.35
 },
 {
  "i": 100,
  "start": 272.35,
  "speechStart": 272.5,
  "speechEnd": 275.18,
  "text": "You walk straight through the inferno.",
  "end": 275.03
 },
 {
  "i": 101,
  "start": 275.03,
  "speechStart": 275.18,
  "speechEnd": 277.78,
  "text": "You find the little girl hiding under a bed.",
  "end": 277.63
 },
 {
  "i": 102,
  "start": 277.63,
  "speechStart": 277.78,
  "speechEnd": 279.76,
  "text": "You wrap her in a wet blanket.",
  "end": 279.61
 },
 {
  "i": 103,
  "start": 279.61,
  "speechStart": 279.76,
  "speechEnd": 282.74,
  "text": "Flaming timber crashes onto your back. CRACK!",
  "end": 282.59
 },
 {
  "i": 104,
  "start": 282.59,
  "speechStart": 282.74,
  "speechEnd": 284.48,
  "text": "Your jacket catches fire.",
  "end": 284.33
 },
 {
  "i": 105,
  "start": 284.33,
  "speechStart": 284.48,
  "speechEnd": 286.72,
  "text": "Your skin blisters instantly.",
  "end": 286.57
 },
 {
  "i": 106,
  "start": 286.57,
  "speechStart": 286.72,
  "speechEnd": 288.06,
  "text": "You feel nothing.",
  "end": 287.91
 },
 {
  "i": 107,
  "start": 287.91,
  "speechStart": 288.06,
  "speechEnd": 289.42,
  "text": "Zero pain.",
  "end": 289.27
 },
 {
  "i": 108,
  "start": 289.27,
  "speechStart": 289.42,
  "speechEnd": 293.08,
  "text": "But your heart races at one hundred and ninety beats per minute.",
  "end": 292.93
 },
 {
  "i": 109,
  "start": 292.93,
  "speechStart": 293.08,
  "speechEnd": 296.02,
  "text": "Your body is going into silent thermal shock.",
  "end": 295.87
 },
 {
  "i": 110,
  "start": 295.87,
  "speechStart": 296.02,
  "speechEnd": 299.08,
  "text": "You burst through the front door into the icy night air!",
  "end": 298.93
 },
 {
  "i": 111,
  "start": 298.93,
  "speechStart": 299.08,
  "speechEnd": 300.8,
  "text": "You hand the child to her mother.",
  "end": 300.65
 },
 {
  "i": 112,
  "start": 300.65,
  "speechStart": 300.8,
  "speechEnd": 303.52,
  "text": "You collapse onto the freezing grass.",
  "end": 303.37
 },
 {
  "i": 113,
  "start": 303.37,
  "speechStart": 303.52,
  "speechEnd": 306.06,
  "text": "Jay rushes over with a fire extinguisher.",
  "end": 305.91
 },
 {
  "i": 114,
  "start": 305.91,
  "speechStart": 306.06,
  "speechEnd": 307.32,
  "text": "He sprays your back.",
  "end": 307.17
 },
 {
  "i": 115,
  "start": 307.17,
  "speechStart": 307.32,
  "speechEnd": 311.0,
  "text": "He checks your pulse. Leo! Stay awake! Look at me!",
  "end": 311.15
 },
 {
  "i": 116,
  "start": 311.15,
  "speechStart": 311.3,
  "speechEnd": 313.34,
  "text": "I do not feel anything...",
  "end": 313.19
 },
 {
  "i": 117,
  "start": 313.19,
  "speechStart": 313.34,
  "speechEnd": 314.7,
  "text": "That is the problem!",
  "end": 314.55
 },
 {
  "i": 118,
  "start": 314.55,
  "speechStart": 314.7,
  "speechEnd": 316.1,
  "text": "You are burning up!",
  "end": 315.95
 },
 {
  "i": 119,
  "start": 315.95,
  "speechStart": 316.1,
  "speechEnd": 320.58,
  "text": "Jay wraps you in emergency blankets and pours ice water over your shoulders.",
  "end": 321.23
 },
 {
  "i": 120,
  "start": 321.23,
  "speechStart": 321.38,
  "speechEnd": 322.62,
  "text": "You survive...",
  "end": 322.47
 },
 {
  "i": 121,
  "start": 322.47,
  "speechStart": 322.62,
  "speechEnd": 326.38,
  "text": "because Jay checked your body before shock took your life.",
  "end": 326.23
 },
 {
  "i": 122,
  "start": 326.23,
  "speechStart": 326.38,
  "speechEnd": 328.82,
  "text": "Is any of this real? Yes.",
  "end": 329.31
 },
 {
  "i": 123,
  "start": 329.31,
  "speechStart": 329.46,
  "speechEnd": 332.02,
  "text": "This real-world medical condition exists.",
  "end": 332.49
 },
 {
  "i": 124,
  "start": 332.49,
  "speechStart": 332.64,
  "speechEnd": 335.44,
  "text": "It is called Congenital Insensitivity to Pain...",
  "end": 335.29
 },
 {
  "i": 125,
  "start": 335.29,
  "speechStart": 335.44,
  "speechEnd": 337.24,
  "text": "or C-I-P.",
  "end": 337.09
 },
 {
  "i": 126,
  "start": 337.09,
  "speechStart": 337.24,
  "speechEnd": 343.52,
  "text": "People born with mutations in the S-C-N-nine-A gene produce zero pain signals.",
  "end": 343.37
 },
 {
  "i": 127,
  "start": 343.37,
  "speechStart": 343.52,
  "speechEnd": 347.08,
  "text": "Children with C-I-P often bite their own tongues...",
  "end": 346.93
 },
 {
  "i": 128,
  "start": 346.93,
  "speechStart": 347.08,
  "speechEnd": 349.0,
  "text": "fracture bones without knowing...",
  "end": 348.85
 },
 {
  "i": 129,
  "start": 348.85,
  "speechStart": 349.0,
  "speechEnd": 352.24,
  "text": "and must wear protective goggles to prevent eye damage.",
  "end": 352.09
 },
 {
  "i": 130,
  "start": 352.09,
  "speechStart": 352.24,
  "speechEnd": 354.08,
  "text": "Pain is not a curse...",
  "end": 353.93
 },
 {
  "i": 131,
  "start": 353.93,
  "speechStart": 354.08,
  "speechEnd": 357.48,
  "text": "it is human survival. That night...",
  "end": 357.33
 },
 {
  "i": 132,
  "start": 357.33,
  "speechStart": 357.48,
  "speechEnd": 360.02,
  "text": "you sit on your bed covered in bandages.",
  "end": 359.87
 },
 {
  "i": 133,
  "start": 359.87,
  "speechStart": 360.02,
  "speechEnd": 361.68,
  "text": "Your phone vibrates.",
  "end": 361.53
 },
 {
  "i": 134,
  "start": 361.53,
  "speechStart": 361.68,
  "speechEnd": 363.08,
  "text": "A video clip plays.",
  "end": 362.93
 },
 {
  "i": 135,
  "start": 362.93,
  "speechStart": 363.08,
  "speechEnd": 365.96,
  "text": "A black van sits under your streetlight.",
  "end": 365.81
 },
 {
  "i": 136,
  "start": 365.81,
  "speechStart": 365.96,
  "speechEnd": 369.38,
  "text": "A woman in a gray coat looks straight into the camera.",
  "end": 369.23
 },
 {
  "i": 137,
  "start": 369.23,
  "speechStart": 369.38,
  "speechEnd": 371.66,
  "text": "We have a boy who stops time.",
  "end": 371.51
 },
 {
  "i": 138,
  "start": 371.51,
  "speechStart": 371.66,
  "speechEnd": 373.58,
  "text": "We have a boy who teleports.",
  "end": 373.43
 },
 {
  "i": 139,
  "start": 373.43,
  "speechStart": 373.58,
  "speechEnd": 376.18,
  "text": "We have a boy who heals in minutes.",
  "end": 376.03
 },
 {
  "i": 140,
  "start": 376.03,
  "speechStart": 376.18,
  "speechEnd": 380.2,
  "text": "But we need someone who can walk through fire without flinching.",
  "end": 380.05
 },
 {
  "i": 141,
  "start": 380.05,
  "speechStart": 380.2,
  "speechEnd": 382.96,
  "text": "Welcome to Project I-F.",
  "end": 382.81
 },
 {
  "i": 142,
  "start": 382.81,
  "speechStart": 382.96,
  "speechEnd": 385.98,
  "text": "So what would you do if you felt zero pain?",
  "end": 385.83
 },
 {
  "i": 143,
  "start": 385.83,
  "speechStart": 385.98,
  "speechEnd": 387.52,
  "text": "Tell us in the comments below.",
  "end": 387.37
 },
 {
  "i": 144,
  "start": 387.37,
  "speechStart": 387.52,
  "speechEnd": 391.2,
  "text": "Which superpower should we do next? Hit like...",
  "end": 391.05
 },
 {
  "i": 145,
  "start": 391.05,
  "speechStart": 391.2,
  "speechEnd": 394.18,
  "text": "and subscribe for Part Two of Project I-F!",
  "end": 395.68
 }
]