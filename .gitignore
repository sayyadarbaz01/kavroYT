*.mov
*.mkv
*.webm
*.avi
out/
build/
renders/
frames/

# ---- Images / previews / thumbnails (never push) ----
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.psd

# ---- Audio (large; voiceovers, music, mixes) ----
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg

